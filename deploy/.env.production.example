# ==============================================================================
# LUKLA OPERATIONS ENGINE — PRODUCTION ENVIRONMENT CONFIGURATION (AWS EC2)
# ==============================================================================

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_db_anda
POSTGRES_DB=lukla_db
DATABASE_URL=postgresql://postgres:ganti_dengan_password_db_anda@postgres:5432/lukla_db?sslmode=disable

# Authentication
AUTH_TOKEN_SECRET=ganti_dengan_string_random_panjang_untuk_jwt

# Application Setting
APP_ENV=production
APP_NAME=lukla-operations-engine
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json

# AWS Services (Amazon S3 & Amazon Bedrock)
# PENTING: Karena instance EC2 sudah memiliki IAM Role dari panitia hackathon,
# AWS SDK Go v2 otomatis mengambil kredensial langsung dari Instance Metadata Service (IMDS).
# JANGAN isi AWS_ACCESS_KEY_ID atau AWS_SECRET_ACCESS_KEY di file ini!
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=bedrock-kb-student8-1791858316
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_KB_ID=NXQHNABELF
