		{
			"name": "02. Articles API",
			"item": [
				{
					"name": "1. List All Articles (Internal Staff)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Returns articles array with pagination meta\", function () {",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.be.an('array');",
									"    pm.expect(jsonData.meta).to.be.an('object');",
									"});",
									"if (jsonData.data && jsonData.data.length > 0) {",
									"    jsonData.data.forEach(function(item) {",
									"        if (item.code === 'ART-SNO-PK01') {",
									"            pm.collectionVariables.set(\"article_parka_id\", item.id);",
									"            console.log(\"Saved article_parka_id: \" + item.id);",
									"        } else if (item.code === 'ART-AVE-TR01') {",
									"            pm.collectionVariables.set(\"article_aventura_id\", item.id);",
									"            pm.collectionVariables.set(\"client_aventura_id\", item.clientId);",
									"            console.log(\"Saved article_aventura_id: \" + item.id);",
									"            console.log(\"Saved client_aventura_id: \" + item.clientId);",
									"        }",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
